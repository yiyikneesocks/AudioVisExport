# AudioVisExport .gitignore

# === CMake 构建产物 ===
/build/
/build-*/
/cmake-build-*/
/build_win/
/out/
/CMakeUserPresets.json

# === 交叉编译工具链缓存（xwin Windows SDK，1GB+，不入库）===
/.xwin-cache/

# === opencode 会话（plans 之外的 node_modules 等）===
/.opencode/

# === IDE / 编辑器 ===
/.vs/
/.vscode/
/.idea/
/.cache/
/.clion*/
*.user
*.suo
*.userprefs

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 编译产物 ===
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.exe

# === 动态库（运行时从 projectM 官方下载，不入 git）===
# 与 Y2Kmeter 一致：bin/*.dll 都从 release 包提取
/third_party/projectm/bin/*.dll

# === 中间产物 ===
/temp_frames/
/temp/
/output/
*.mp4
*.mov
*.mkv
*.webm

# === JUCE FetchContent 缓存 ===
/_deps/

# === 人机协作收件箱（本地对话用，无需推送）===
/docs/inbox/

# 主机侧辅助工具的 venv（正常应由 tools/setup_env.sh 建在仓库**外面**；
# 万一有人建在里面，这里挡住，别让上万个第三方 .py 污染 find/grep）
/tools-venv/
/.venv*/
__pycache__/
*.pyc
